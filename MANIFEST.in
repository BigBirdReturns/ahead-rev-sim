include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include SECURITY.md
include GOVERNANCE.md
include LICENSE
include CITATION.cff
include pyproject.toml
include .editorconfig
include .gitattributes
include .gitignore
include src/ahead_rev_sim/py.typed

recursive-include src/ahead_rev_sim/data *.json
recursive-include docs *.md
recursive-include schemas *.json
recursive-include examples *.asm *.c *.expected *.json
recursive-include scripts *.py
recursive-include tests *.py
recursive-include .github *.md *.yml *.yaml

prune artifacts
prune build
prune dist
prune .venv
recursive-exclude * __pycache__
recursive-exclude * *.py[cod]
