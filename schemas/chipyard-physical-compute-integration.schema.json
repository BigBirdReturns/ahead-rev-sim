{
  "$defs": {
    "artifact_record": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "sha256",
        "bytes"
      ],
      "type": "object"
    },
    "blob_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "patterns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_witness": {
      "additionalProperties": false,
      "properties": {
        "blob_sha": {
          "$ref": "#/$defs/blob_sha"
        },
        "required_patterns": {
          "$ref": "#/$defs/patterns"
        }
      },
      "required": [
        "blob_sha",
        "required_patterns"
      ],
      "type": "object"
    }
  },
  "$id": "https://bigbirdreturns.github.io/ahead-rev-sim/schemas/chipyard-physical-compute-integration.schema.json",
