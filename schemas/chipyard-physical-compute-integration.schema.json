    },
    "artifact_type": {
      "const": "chipyard_physical_compute_injector_bundle"
    },
    "base_address": {
      "minimum": 0,
      "multipleOf": 4096,
      "type": "integer"
    },
    "chipyard_source_contract": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "const": "e27c6561c0066c1f60bf4eb4885a38391c850ac0"
        },
        "repository": {
          "const": "ucb-bar/chipyard"
        },
        "source_witnesses": {
          "additionalProperties": false,
          "properties": {
            "generators/chipyard/src/main/scala/DigitalTop.scala": {
              "$ref": "#/$defs/source_witness"
            },
            "generators/chipyard/src/main/scala/config/RocketConfigs.scala": {
              "$ref": "#/$defs/source_witness"
            },
            "generators/chipyard/src/main/scala/example/GCD.scala": {
              "$ref": "#/$defs/source_witness"
            },
            "scripts/build-setup.sh": {
              "$ref": "#/$defs/source_witness"
            },
            "variables.mk": {
              "$ref": "#/$defs/source_witness"
            }
          },
          "required": [
            "generators/chipyard/src/main/scala/example/GCD.scala",
            "generators/chipyard/src/main/scala/config/RocketConfigs.scala",
            "generators/chipyard/src/main/scala/DigitalTop.scala",
            "variables.mk",
            "scripts/build-setup.sh"
          ],
          "type": "object"
        },
        "submodule_witnesses": {
          "additionalProperties": false,
          "properties": {
            "generators/testchipip/src/main/scala/soc/SubsystemInjector.scala": {
              "$ref": "#/$defs/patterns"
            }
          },
          "required": [
            "generators/testchipip/src/main/scala/soc/SubsystemInjector.scala"
          ],
          "type": "object"
        }
      },
      "required": [
        "repository",
        "commit",
        "source_witnesses",
        "submodule_witnesses"
      ],
      "type": "object"
    },
    "claim_boundary": {
      "minLength": 1,
      "type": "string"
    },
    "control_question": {
      "minLength": 1,
      "type": "string"
    },
    "generated_artifacts": {
      "additionalProperties": false,
