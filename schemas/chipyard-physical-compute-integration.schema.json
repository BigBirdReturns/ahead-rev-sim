  "required": [
    "schema_version",
    "artifact_type",
    "portable_binding",
    "base_address",
    "chipyard_source_contract",
    "integration",
    "abi_sha256",
    "generated_artifacts",
    "qualification",
    "claim_boundary",
    "control_question",
    "manifest_sha256"
  ],
  "title": "ahead-rev-sim pinned Chipyard physical-compute injector bundle",
  "type": "object"
}
