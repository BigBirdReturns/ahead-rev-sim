{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BigBirdReturns/ahead-rev-sim/schemas/execution-target-invocation.schema.json",
  "title": "Execution Target Invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "invocation_id",
    "capsule",
    "interface",
    "policy",
    "control_question",
    "invocation_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "ahead.execution-target-invocation/v0.1"
    },
    "artifact_type": {
      "const": "execution_target_invocation"
    },
    "invocation_id": {
      "type": "string",
      "minLength": 1
    },
    "capsule": {
      "$ref": "#/$defs/capsule"
    },
    "interface": {
      "$ref": "#/$defs/interface"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "control_question": {
      "type": "string",
      "minLength": 1
    },
    "invocation_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capsule_id",
        "workload_sha256",
        "descriptor_sha256",
        "input_sha256",
        "accepted_output_sha256",
        "capsule_sha256"
      ],
      "properties": {
        "capsule_id": {
          "type": "string",
          "minLength": 1
        },
        "workload_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "descriptor_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "accepted_output_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "capsule_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abi",
        "commands",
        "required_capabilities"
      ],
      "properties": {
        "abi": {
          "const": "physical-compute-mmio/v1"
        },
        "commands": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "required_capabilities": {
          "$ref": "#/$defs/uniqueStrings"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_authority",
        "provider_authority",
        "software_fallback_id",
        "timeout_seconds",
        "cleanup_required_after_prepare"
      ],
      "properties": {
        "acceptance_authority": {
          "const": "local"
        },
        "provider_authority": {
          "const": "execution_only"
        },
        "software_fallback_id": {
          "type": "string",
          "minLength": 1
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "cleanup_required_after_prepare": {
          "type": "boolean"
        }
      }
    }
  }
}
