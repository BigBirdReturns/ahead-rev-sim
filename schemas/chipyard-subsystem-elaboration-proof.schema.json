{
  "$defs": {
    "file_record": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "git_blob_sha1": {
          "$ref": "#/$defs/sha1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "git_blob_sha1",
        "sha256",
        "bytes"
      ],
      "type": "object"
    },
    "sha1": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "submodule_record": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/sha1"
        },
        "prefix": {
          "const": " "
        },
        "state": {
          "const": "exact"
        }
      },
      "required": [
        "commit",
        "state",
        "prefix"
      ],
      "type": "object"
    }
  },
  "$id": "https://bigbirdreturns.github.io/ahead-rev-sim/schemas/chipyard-subsystem-elaboration-proof.schema.json",
