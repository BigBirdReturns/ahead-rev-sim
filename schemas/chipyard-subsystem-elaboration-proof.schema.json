              "type": "string"
            },
            "record_count": {
              "minimum": 1,
              "type": "integer"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "name",
            "sha256",
            "bytes",
            "record_count"
          ],
          "type": "object"
        },
        "chisel_log": {
