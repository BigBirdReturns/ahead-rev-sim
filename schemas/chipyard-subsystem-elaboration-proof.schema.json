        "firrtl": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "module_count": {
              "minimum": 1,
              "type": "integer"
            },
            "name": {
              "pattern": "PhysicalComputeRocketConfig.*\\.fir$",
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "name",
            "sha256",
            "bytes",
            "module_count"
