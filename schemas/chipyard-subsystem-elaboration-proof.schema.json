            "name": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "name",
            "sha256",
            "bytes"
          ],
          "type": "object"
        },
        "elaboration_log": {
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "minimum": 1,
              "type": "integer"
            },
            "name": {
              "minLength": 1,
              "type": "string"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "name",
            "sha256",
            "bytes"
          ],
          "type": "object"
