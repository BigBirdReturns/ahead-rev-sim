{
  "$defs": {
    "file": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "path",
        "role",
        "sha256"
      ],
      "type": "object"
    },
    "sha": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "shaOrNull": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha"
        },
        {
          "type": "null"
        }
      ]
    },
    "strings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "$id": "https://bigbirdreturns.github.io/ahead-rev-sim/schemas/remote-venue-submission.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_type": {
      "const": "remote_venue_submission"
    },
    "control_question": {
      "minLength": 1,
      "type": "string"
    },
    "execution": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "allOf": [
            {
              "$ref": "#/$defs/strings"
            },
            {
              "minItems": 1
            }
          ]
        },
        "container_image_digest": {
          "$ref": "#/$defs/shaOrNull"
        },
        "environment": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "resource_request": {
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          },
          "type": "object"
        },
        "software_fallback_id": {
          "minLength": 1,
          "type": "string"
        },
        "timeout_seconds": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "working_directory": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "command",
        "working_directory",
        "environment",
        "resource_request",
        "timeout_seconds",
        "software_fallback_id",
        "container_image_digest"
      ],
      "type": "object"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 1,
      "type": "array"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "dependency_mode": {
          "const": "commodity_only"
        },
        "local_replay_required": {
          "const": true
        },
        "migration_allowed": {
          "const": true
        },
        "provider_authority": {
          "const": "execution_only"
        },
        "raw_return_required": {
          "const": true
        },
        "service_completion_is_acceptance": {
          "const": false
        }
      },
      "required": [
        "dependency_mode",
        "provider_authority",
        "service_completion_is_acceptance",
        "raw_return_required",
        "local_replay_required",
        "migration_allowed"
      ],
      "type": "object"
    },
    "requested_receipts": {
      "allOf": [
        {
          "$ref": "#/$defs/strings"
        },
        {
          "minItems": 1
        }
      ]
    },
    "required_return_artifacts": {
      "allOf": [
        {
          "$ref": "#/$defs/strings"
        },
        {
          "minItems": 1
        }
      ]
    },
    "schema_version": {
      "const": "ahead.remote-venue-submission/v0.1"
    },
    "submission_id": {
      "minLength": 1,
      "type": "string"
    },
    "submission_sha256": {
      "$ref": "#/$defs/sha"
    },
    "workload": {
      "additionalProperties": false,
      "properties": {
        "accepted_output_sha256": {
          "$ref": "#/$defs/sha"
        },
        "accepted_work_unit": {
          "minLength": 1,
          "type": "string"
        },
        "accepted_work_units": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha"
        },
        "contract_id": {
          "minLength": 1,
          "type": "string"
        },
        "quality_rule": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "artifact_sha256",
        "accepted_output_sha256",
        "accepted_work_unit",
        "accepted_work_units",
        "quality_rule"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "submission_id",
    "workload",
    "execution",
    "files",
    "required_return_artifacts",
    "requested_receipts",
    "policy",
    "control_question",
    "submission_sha256"
  ],
  "title": "ahead-rev-sim remote venue submission",
  "type": "object"
}
