{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigbirdreturns.github.io/ahead-rev-sim/schemas/physical-substrate.schema.json",
  "title": "ahead-rev-sim physical substrate descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "substrate_id",
    "operator_class",
    "dynamics_class",
    "realization_class",
    "coupling_mode",
    "determinism",
    "reset_contract",
    "channels",
    "state_words",
    "environment_boundary",
    "parameters",
    "energy_contract",
    "portable_binding",
    "optional_riscv_extension",
    "fallback_model_id",
    "schema_version"
  ],
  "properties": {
    "substrate_id": {
      "type": "string",
      "minLength": 1
    },
    "operator_class": {
      "type": "string",
      "minLength": 1
    },
    "dynamics_class": {
      "enum": [
        "deterministic_relaxation",
        "thermodynamic_stochastic",
        "oscillatory",
        "reservoir",
        "reversible"
      ]
    },
    "determinism": {
      "enum": [
        "exact",
        "replay_with_trace",
        "distributional"
      ]
    },
    "reset_contract": {
      "enum": [
        "exact",
        "calibrated",
        "statistical",
        "none"
      ]
    },
    "channels": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "channel_id",
          "direction",
          "roles",
          "physical_quantity",
          "unit",
          "dtype",
          "calibration_required",
          "sample_period_ns"
        ],
        "properties": {
          "channel_id": {
            "type": "string",
            "minLength": 1
          },
          "direction": {
            "enum": [
              "input",
              "output",
              "internal"
            ]
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "operand",
                "dynamics",
                "energy",
                "context",
                "result"
              ]
            }
          },
          "physical_quantity": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "dtype": {
            "type": "string",
            "minLength": 1
          },
          "calibration_required": {
            "type": "boolean"
          },
          "sample_period_ns": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "state_words": {
      "type": "integer",
      "minimum": 0
    },
    "parameters": {
      "type": "object"
    },
    "energy_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_class",
        "evidence_class",
        "measurement_boundary",
        "instrument_ref",
        "supplied_joules",
        "recovered_or_harvested_joules"
      ],
      "properties": {
        "source_class": {
          "enum": [
            "external",
            "ambient_harvested",
            "signal_coupled",
            "recovered"
          ]
        },
        "evidence_class": {
          "enum": [
            "reference_model",
            "simulated",
            "measured"
          ]
        },
        "measurement_boundary": {
          "type": "string",
          "minLength": 1
        },
        "instrument_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "supplied_joules": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "recovered_or_harvested_joules": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "portable_binding": {
      "const": "physical-compute-mmio/v1"
    },
    "optional_riscv_extension": {
      "const": "Xphys"
    },
    "fallback_model_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "ahead.physical-substrate/v0.1"
    },
    "realization_class": {
      "enum": [
        "designed_device",
        "harvested_environment",
        "embodied_structure",
        "biological_system",
        "virtual_reference"
      ]
    },
    "coupling_mode": {
      "enum": [
        "observe_only",
        "stimulate_and_observe",
        "closed_loop"
      ]
    },
    "environment_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
